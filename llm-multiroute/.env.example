# Ollama Cloud API
#OLLAMA_BASE_URL=https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=your_api_key_here
OLLAMA_TEMPERATURE=0.7

# Per-route model assignments (must be available on Ollama cloud)
OLLAMA_MODEL_CLASSIFY=qwen3:4b #gemma3:4b
OLLAMA_MODEL_SENTIMENT=qwen3:4b #ministral-3:3b
OLLAMA_MODEL_SUMMARIZE=qwen3:4b #ministral-3:8b
OLLAMA_MODEL_INTENT=qwen3:4b #gemma3:12b

# Server
SERVER_PORT=8082
